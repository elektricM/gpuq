}
(( $+functions[_gpuq__help__run_commands] )) ||
_gpuq__help__run_commands() {
    local commands; commands=()
    _describe -t commands 'gpuq help run commands' commands "$@"
}
(( $+functions[_gpuq__help__status_commands] )) ||
_gpuq__help__status_commands() {
    local commands; commands=()
    _describe -t commands 'gpuq help status commands' commands "$@"
}
(( $+functions[_gpuq__hold_commands] )) ||
_gpuq__hold_commands() {
    local commands; commands=()
    _describe -t commands 'gpuq hold commands' commands "$@"
}
(( $+functions[_gpuq__run_commands] )) ||
_gpuq__run_commands() {
    local commands; commands=()
    _describe -t commands 'gpuq run commands' commands "$@"
}
(( $+functions[_gpuq__status_commands] )) ||
_gpuq__status_commands() {
    local commands; commands=()
    _describe -t commands 'gpuq status commands' commands "$@"
}

if [ "$funcstack[1]" = "_gpuq" ]; then
    _gpuq "$@"
else
    compdef _gpuq gpuq
fi
