_gpuq__help_commands() {
    local commands; commands=(
'daemon:Run the daemon' \
'check-config:Load and validate the config, then exit' \
'status:Show the arbiter state, leases and queue' \
'run:Run a command under a GPU lease' \
'hold:Hold a lease until Ctrl-C' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'gpuq help commands' commands "$@"
}
(( $+functions[_gpuq__help__check-config_commands] )) ||
_gpuq__help__check-config_commands() {
    local commands; commands=()
    _describe -t commands 'gpuq help check-config commands' commands "$@"
}
(( $+functions[_gpuq__help__daemon_commands] )) ||
_gpuq__help__daemon_commands() {
    local commands; commands=()
    _describe -t commands 'gpuq help daemon commands' commands "$@"
}
(( $+functions[_gpuq__help__help_commands] )) ||
_gpuq__help__help_commands() {
