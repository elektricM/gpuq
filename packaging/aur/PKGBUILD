# Maintainer: Martin
pkgname=gpud
pkgver=0.1.0
pkgrel=1
pkgdesc='GPU manager and queue: one card, many AI and GPU workloads'
arch=(x86_64 aarch64)
url='https://github.com/elektricM/gpud'
license=('GPL-3.0-or-later')
makedepends=(cargo)
backup=('etc/gpud/config.toml')
options=('!lto')  # makepkg's LTO flags break ring's assembly at link time
source=("$pkgname-$pkgver.tar.gz::https://github.com/elektricM/gpud/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('38bedbacf1d248c8d1fd17900d7e75c458aa23e7c4b5d7ef05725992180a09fe')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/gpud "$pkgdir/usr/bin/gpud"
  install -Dm644 packaging/systemd/gpud.service "$pkgdir/usr/lib/systemd/system/gpud.service"
  install -Dm644 packaging/systemd/gpud.user.service "$pkgdir/usr/lib/systemd/user/gpud.service"
  install -Dm644 packaging/systemd/gpud.sysusers "$pkgdir/usr/lib/sysusers.d/gpud.conf"
  install -Dm644 examples/gpud.toml "$pkgdir/etc/gpud/config.toml"
  install -Dm644 examples/gpud.toml "$pkgdir/usr/share/doc/$pkgname/examples/gpud.toml"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
