# Maintainer: Martin Dolez <martin@dolez.fr>
pkgname=gpuq
pkgver=0.2.0
pkgrel=1
pkgdesc='GPU scheduler for Linux'
arch=(x86_64 aarch64)
url='https://github.com/elektricM/gpuq'
license=('GPL-3.0-or-later')
depends=(gcc-libs glibc)
makedepends=(cargo)
backup=('etc/gpuq/config.toml')
options=('!lto')  # makepkg's LTO flags break ring's assembly at link time
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('dcf03d7cfe3517c4c22afa1ccd8a0a0588af782c12fea66a21330e4d91190f4f')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/gpuq -t "$pkgdir/usr/bin"
  install -Dm644 packaging/systemd/gpuq.service "$pkgdir/usr/lib/systemd/system/gpuq.service"
  install -Dm644 packaging/systemd/gpuq.user.service "$pkgdir/usr/lib/systemd/user/gpuq.service"
  install -Dm644 packaging/systemd/gpuq.sysusers "$pkgdir/usr/lib/sysusers.d/gpuq.conf"
  install -Dm644 examples/gpuq.toml "$pkgdir/etc/gpuq/config.toml"
  install -Dm644 man/*.1 -t "$pkgdir/usr/share/man/man1"
  install -Dm644 completions/gpuq.bash "$pkgdir/usr/share/bash-completion/completions/gpuq"
  install -Dm644 completions/_gpuq -t "$pkgdir/usr/share/zsh/site-functions"
  install -Dm644 completions/gpuq.fish -t "$pkgdir/usr/share/fish/vendor_completions.d"
  install -Dm644 README.md CHANGELOG.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm644 docs/*.md -t "$pkgdir/usr/share/doc/$pkgname/docs"
  install -Dm644 examples/* -t "$pkgdir/usr/share/doc/$pkgname/examples"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
