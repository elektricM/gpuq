[Unit]
Description=gpud, GPU manager and queue (user instance)
Documentation=https://github.com/elektricM/gpud
After=network.target

[Service]
Type=notify
# Reads ~/.config/gpud/config.toml. Easiest mode when gpud must start and stop
# `systemctl --user` services such as ComfyUI.
ExecStart=/usr/bin/gpud daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
